// Microbiome Workflows Configuration
// Default settings for standardized workflows

// Default parameters
params {
    // Environment settings
    qiime2_conda_env = 'qiime2-amplicon'
    r_conda_env = 'r-microbiome'
    
    // SILVA database defaults
    silva_version = '138.2'
    silva_target = 'SSURef_NR99'
    filter_labels = ['Archaea', 'Bacteria', 'Eukaryota']
    filter_min_lengths = [900, 1200, 1400]
    derep_mode = 'uniq'
    
    // V3V4 primers (default)
    f_primerv3v4 = 'CCTAYGGGRBGCASCAG'
    r_primerv3v4 = 'GGACTACNNGGGTATCTAAT'
    
    // V1V2 primers (alternative)
    f_primerv1v2 = 'AGAGTTTGATCCTGGCTCAG'
    r_primerv1v2 = 'CTGCTGCCTYCCGTA'
    
    // DADA2 defaults (can be overridden per project)
    dada2_trunc_len_f = 225
    dada2_trunc_len_r = 222
    dada2_trim_left_f = 10
    dada2_trim_left_r = 0
    dada2_n_reads_learn = 1000000
    dada2_n_threads = 0
    
    // Decontamination defaults
    use_decontam_frequency = true
    decontam_freq_concentration_column = 'DNA concentration'
    use_decontam_prevalence = false
    decontam_prev_control_column = 'Decontam Control'
    decontam_prev_control_indicator = 'Negative Control'
    
    // Analysis defaults
    diversity_sampling_depth = 10000
    
    // R analysis defaults
    analysis_config = [
        alpha_indices: "shannon,simpson_lambda,faith_diversity",
        alpha_names: "Shannon,Simpson,Faith_PD",
        alpha_niter: 100,
        prv_cut: 0.1,
        lib_cut: 1000,
        alpha: 0.05,
        p_adj_method: "BH",
        filter_incertae_sedis: true,
        normalization: "TSS",
        transform: "LOG"
    ]
}

// Conda configuration
conda {
    enabled = true
    useMamba = true
    createTimeout = '30 min'
}

// Process labels for resource allocation
process {
    withLabel: process_low {
        cpus = 1
        memory = '2 GB'
        time = '1h'
    }
    withLabel: process_medium {
        cpus = 4
        memory = '8 GB'
        time = '4h'
    }
    withLabel: process_high {
        cpus = 8
        memory = '16 GB'
        time = '8h'
    }
    
    // QIIME2 processes
    withName: 'RUN_DADA2_PAIRED_END_QIIME2' {
        label = 'process_high'
        conda = params.qiime2_conda_env
    }
    withName: 'CLASSIFY_TAXONOMY' {
        label = 'process_medium'
        conda = params.qiime2_conda_env
    }
    withName: 'ALIGN_AND_TREE_QIIME2' {
        label = 'process_medium'
        conda = params.qiime2_conda_env
    }
    
    // R processes
    withName: 'CALC_ALPHA_DIVERSITY' {
        label = 'process_medium'
        conda = params.r_conda_env
    }
    withName: 'CALC_ANCOMBC2' {
        label = 'process_high'
        conda = params.r_conda_env
    }
    withName: 'CALC_MAASLIN3' {
        label = 'process_low'
        conda = params.r_conda_env
    }
    withName: 'PREPARE_TSE_DATA' {
        label = 'process_medium'
        conda = params.r_conda_env
    }
}

// Execution profiles
profiles {
    conda {
        conda.enabled = true
        conda.useMamba = true
    }
    
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
}