// Nextflow configuration template for microbiome-workflows
// Copy this to your project directory as nextflow.config

// === MERGE STRATEGY ===
// "post_dada2" - Run DADA2 per batch, merge feature tables (default)
// "pre_dada2"  - Merge trimmed reads, run single DADA2 (better ASV consistency across batches)
params.merge_strategy = "post_dada2"

// === BATCH CONFIGURATION ===
params.batches = [
    [
        name: 'batch1',
        metadata_path: './data/batch1.tsv',
        input: [
            data_dir: './data/raw_data/batch1',
            zip_filename: null,  // Set if using Novogene ZIP format
            // accession_ids: ['SRR...'],  // Set for SRA downloads
        ],
        primers: [
            forward: 'CCTAYGGGRBGCASCAG',   // V3V4 forward
            reverse: 'GGACTACNNGGGTATCTAAT', // V3V4 reverse
        ],
        trimming: [
            enabled: true,
            use_sampleseq: false,       // true if using Novogene SampleSeq_info.xls
            nextseq_trim: null,         // Set to integer (e.g. 20) for NextSeq/NovaSeq two-color chemistry
            // samples_with_additional_barcodes: [:],  // For samples needing extra barcode removal
        ],
        dada2: [
            trunc_len_f: 225,
            trunc_len_r: 222,
            trim_left_f: 0,  // Set >0 if primers weren't fully removed
            trim_left_r: 0,
            // max_ee_f: 2,           // Override max expected errors (forward)
            // max_ee_r: 2,           // Override max expected errors (reverse)
            // n_reads_learn: 1000000,
            // n_threads: 8,
            // binned_quality_scores: [2, 11, 25, 37],  // For NovaSeq binned quality
        ],
        decontam: [
            method: "frequency",  // "frequency", "prevalence", "combined", or "none"
        ],
        taxonomy: [:],  // Uses global params.taxonomy; override keys here if needed
        other: [
            // Per-batch overrides for pipeline options (override global params above):
            // diversity_sampling_depth: 10000,
            // skip_picrust2: false,
            // skip_diversity: false,
            // Steps that do not feed the feature table, taxonomy or tree (amplicon_wf.nf):
            // skip_qc: false,                   // FastQC/MultiQC before and after trimming, host-alignment MultiQC
            // skip_summaries: false,            // QIIME2 .qzv summaries: trimmed reads, DADA2, taxonomy barplot, gram staining
            // skip_contaminant_taxonomy: false, // Classification of the ASVs decontam removed
            // skip_phylogeny: false,            // Per-batch tree (also skips phylogenetic diversity)
            // amplicon_type: '16S',           // '16S' or 'ITS'
            // database: 'silva',              // 'silva' or 'unite'
            // filter_samples_by_metadata: false,
        ],
    ],
    [
        name: 'batch2',
        metadata_path: './data/batch2.tsv',
        input: [
            data_dir: './data/raw_data/batch2',
            zip_filename: null,
        ],
        primers: [
            forward: 'CCTAYGGGRBGCASCAG',
            reverse: 'GGACTACNNGGGTATCTAAT',
        ],
        trimming: [
            enabled: true,
            use_sampleseq: false,
            nextseq_trim: null,
        ],
        dada2: [
            trunc_len_f: 225,
            trunc_len_r: 222,
            trim_left_f: 0,
            trim_left_r: 0,
        ],
        decontam: [
            method: "frequency",
        ],
        taxonomy: [:],
        other: [:],
    ],
]

// === SILVA DATABASE ===
params.silva = [
    version: '138.2',
    target: 'SSURef_NR99',
    filter_labels: ['Archaea', 'Bacteria', 'Eukaryota'],
    filter_min_lengths: [900, 1200, 1400],
    derep_mode: 'uniq',
]

// === PIPELINE OPTIONS ===
params.amplicon_type = '16S'                  // '16S' or 'ITS'
params.database = 'silva'                     // 'silva' or 'unite'
params.filter_samples_by_metadata = false     // Filter samples by metadata before DADA2
params.seed = 42                              // Random seed for reproducibility
params.ncbi_email = null                      // Required for SRA/accession downloads
params.fastq_pattern = null                   // Override FASTQ filename glob (default: '*_{R1,R2}_001.fastq.gz')

// === DADA2 ===
params.dada2 = [
    n_reads_learn: 1000000,
    n_threads: 8,
    trim_left_f: 0,
    trim_left_r: 0,
    max_ee_f: 2,                        // Max expected errors per base (forward reads); lower = stricter
    max_ee_r: 2,                        // Max expected errors per base (reverse reads)
    sample_prefix_to_remove: null,      // Regex pattern to strip from sample IDs
    binned_quality_scores: null,        // e.g. [2, 11, 25, 37] for NovaSeq binned quality
]

// === TRIMMING ===
params.cutadapt = [
    minimum_length: 100,
    nextseq_trim: null,  // Set to integer (e.g. 20) for NextSeq/NovaSeq two-color chemistry data
    cpus: 4,
]

// === DECONTAMINATION ===
// Note: the final fallback for method is "none" (no decontam) if params.decontam is absent.
// Set method to "none" to explicitly disable decontam.
params.decontam = [
    method: "frequency",              // "frequency", "prevalence", "combined", or "none"
    freq_concentration_column: 'DNA_concentration',  // Metadata column with DNA concentration values
    prev_control_column: 'Decontam_Control',         // Metadata column identifying controls
    prev_control_indicator: 'Negative Control',      // Cell value that marks a negative control
    threshold: 0.1,                   // P-value threshold: features below this are flagged as contaminants
]

// === TAXONOMY ===
// Note: classification_confidence applies to sklearn (0–1 scale).
// DADA2 taxonomy uses a separate bootstrap threshold (0–100 scale), hardcoded to 80 in the module.
params.taxonomy = [
    enable_dada2_taxonomy: false,         // Run DADA2 taxonomy in addition to sklearn
    enable_comparison: false,             // Compare sklearn vs DADA2 taxonomy results
    classification_confidence: 0.7,       // Sklearn confidence threshold (0.0–1.0)
    classifier_read_orientation: 'auto',  // 'auto', 'same', or 'reverse-complement'
    classifier_cpus: 4,
    dada2_add_species_allow_multiple: 3,
    dada2_add_species_verbose: true,
]

// === PHYLOGENY ===
params.phylogeny = [
    n_threads: 4,
    mask_max_gap_freq: 1.0,     // Max gap frequency for alignment masking (1.0 = no filtering)
    mask_min_conservation: 0.4, // Min conservation for alignment masking
]

// === PICRUST2 ===
// Runs by default. Set skip: true to disable (e.g. for ITS amplicons).
params.picrust2 = [
    skip: false,
    threads: null,                      // Defaults to params.dada2.n_threads if not specified
    diversity_sampling_depth: null,     // null = auto-infer from data; set integer to fix depth
    skip_pathway_diversity: false,
    hsp_method: 'mp',                   // Hidden state prediction: mp, emp_prob, pic, scp, subtree_average
    max_nsti: 2,                        // Max NSTI cutoff; ASVs above this are excluded
]

// === DIVERSITY ===
// Runs by default. Set skip_diversity: true to disable.
// When diversity_sampling_depth is null, depth is inferred automatically from the data.
params.diversity_sampling_depth = 10000
params.skip_diversity = false
params.auto_depth_percentile = 0.0      // Auto-infer sampling depth at this percentile (0.0 = disabled)

// === QUALITY CONTROL ===
params.qc = [
    fastqc_cpus: 2,
]

// === HOST ALIGNMENT (bowtie2) ===
// Optional: align trimmed reads against a host reference (e.g. GRCh38 + chrM)
// and drop host-mapped read pairs before DADA2. Runs AFTER cutadapt so bowtie2
// sees primer-free inserts (default end-to-end mode requires the full read to
// align). Per-sample mapping rates are aggregated into a dedicated MultiQC report.
//
// host_fasta accepts either a local path or a URL (http/https/ftp). URLs are
// downloaded once and cached in cache_dir (alongside the bowtie2 index).
params.host_alignment = [
    enabled: false,
    remove_aligned: true,            // false = report-only, true = drop host-mapped pairs
    // Example URL (Ensembl GRCh38 soft-masked primary assembly, includes chrM):
    //   'https://ftp.ensembl.org/pub/release-112/fasta/homo_sapiens/dna/Homo_sapiens.GRCh38.dna_sm.primary_assembly.fa.gz'
    host_fasta: null,
    sensitivity: 'very-sensitive',   // bowtie2 end-to-end preset
    cpus: 4,
]

// === R DIVERSITY (TSE-based) ===
// Alpha/beta diversity calculated on TreeSummarizedExperiment objects via mia.
// Used by R_ALPHA_DIVERSITY and R_BETA_DIVERSITY subworkflows.
params.r_diversity = [
    seed: 14100715,                  // Random seed for rarefaction
    niter: 500,                      // Number of rarefaction iterations
    alpha: [
        indices: 'shannon,faith_diversity',   // Comma-separated mia::addAlpha index names
        names: 'Shannon,Faith_PD',            // Comma-separated display names (must match indices count)
    ],
    beta: [
        distance_methods: 'jaccard,bray,unifrac_unweighted,unifrac_weighted',  // Comma-separated distance methods
        ncomponents: 2,              // Number of MDS ordination components
    ],
]

// === ENVIRONMENT ===
params.qiime2_conda_env = '/path/to/envs/qiime2-amplicon-2026.1'
params.r_conda_env = '/path/to/envs/microbiome'

// === PROCESS CONFIGURATION ===
process {
    // Default settings
    conda = params.qiime2_conda_env
    errorStrategy = 'retry'
    maxRetries = 2

    // Resource labels
    withLabel: 'process_low' {
        cpus = 2
        memory = '4 GB'
        time = '1h'
    }

    withLabel: 'process_medium' {
        cpus = 4
        memory = '8 GB'
        time = '4h'
    }

    withLabel: 'process_high' {
        cpus = 8
        memory = '32 GB'
        time = '12h'
    }

    // Specific process overrides
    withName: 'RUN_DADA2_PAIRED_END_QIIME2' {
        cpus = 8
        memory = '32 GB'
        time = '24h'
    }

    withName: 'CREATE_NB_CLASSIFIER' {
        cpus = 4
        memory = '16 GB'
        time = '8h'
    }
}

// === PROFILES ===
profiles {
    standard {
        process.executor = 'local'
    }

    slurm {
        process.executor = 'slurm'
        process.queue = 'normal'
        process.clusterOptions = '--account=your_account'
    }

    conda {
        conda.enabled = true
        conda.useMamba = true  // Faster dependency resolution
    }

    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }

    test {
        params.dada2.n_reads_learn = 10000
        params.dada2.n_threads = 2
        params.diversity_sampling_depth = 100
    }
}

// === EXECUTION SETTINGS ===
executor {
    name = 'local'
    cpus = 16
    memory = '64 GB'
}

// === REPORTS ===
report {
    enabled = true
    file = 'reports/execution_report.html'
    overwrite = true
}

timeline {
    enabled = true
    file = 'reports/timeline.html'
    overwrite = true
}

trace {
    enabled = true
    file = 'reports/trace.txt'
    overwrite = true
}

dag {
    enabled = true
    file = 'reports/dag.html'
    overwrite = true
}

// === MANIFEST ===
manifest {
    name = 'microbiome-amplicon-analysis'
    author = 'Your Name'
    description = 'Amplicon microbiome analysis pipeline'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.04'
    version = '1.0.0'
}
