// Nextflow configuration template for microbiome-workflows
// Copy this to your project directory as nextflow.config

// === MERGE STRATEGY ===
// "post_dada2" - Run DADA2 per batch, merge feature tables (default)
// "pre_dada2"  - Merge trimmed reads, run single DADA2 (better ASV consistency)
params.merge_strategy = "post_dada2"

// === GLOBAL METADATA ===
params.metadata_file = "./data/metadata.tsv"

// === BATCH CONFIGURATION ===
params.batches = [
    [
        name: 'batch1',
        metadata_path: './data/batch1.tsv',
        input: [
            data_dir: './data/raw_data/batch1',
            zip_filename: null,  // Set if using Novogene ZIP format
            // accession_ids: ['SRR...'],  // Set for SRA downloads
        ],
        primers: [
            forward: 'CCTAYGGGRBGCASCAG',   // V3V4 forward
            reverse: 'GGACTACNNGGGTATCTAAT', // V3V4 reverse
        ],
        trimming: [
            enabled: true,
            use_sampleseq: false,  // true if using Novogene SampleSeq_info.xls
            // samples_with_additional_barcodes: [:],  // For samples needing extra barcode removal
        ],
        dada2: [
            trunc_len_f: 225,
            trunc_len_r: 222,
            trim_left_f: 0,  // Set >0 if primers weren't fully removed
            trim_left_r: 0,
            // n_reads_learn: 1000000,  // Override if needed
            // n_threads: 8,
            // binned_quality_scores: [2, 11, 25, 37],  // For platforms with binned quality scores (e.g. NovaSeq)
        ],
        decontam: [
            method: "frequency",  // "frequency", "prevalence", or "none"
        ],
        taxonomy: [:],  // Uses global taxonomy params
        other: [
            // diversity_sampling_depth: 10000,  // Set to enable diversity analysis
        ],
    ],
    [
        name: 'batch2',
        metadata_path: './data/batch2.tsv',
        input: [
            data_dir: './data/raw_data/batch2',
            zip_filename: null,
        ],
        primers: [
            forward: 'CCTAYGGGRBGCASCAG',
            reverse: 'GGACTACNNGGGTATCTAAT',
        ],
        trimming: [
            enabled: true,
            use_sampleseq: false,
        ],
        dada2: [
            trunc_len_f: 225,
            trunc_len_r: 222,
            trim_left_f: 0,
            trim_left_r: 0,
        ],
        decontam: [
            method: "frequency",
        ],
        taxonomy: [:],
        other: [:],
    ],
]

// === SILVA DATABASE ===
params.silva = [
    version: '138.2',
    target: 'SSURef_NR99',
    filter_labels: ['Archaea', 'Bacteria', 'Eukaryota'],
    filter_min_lengths: [900, 1200, 1400],
    derep_mode: 'uniq',
]

// === DADA2 DEFAULTS ===
params.dada2 = [
    n_reads_learn: 1000000,
    n_threads: 8,
    sample_prefix_to_remove: null,  // Regex pattern to strip from sample IDs
    binned_quality_scores: null,    // List of binned quality scores, e.g. [2, 11, 25, 37] for NovaSeq
]

// === TAXONOMY ===
params.taxonomy = [
    enable_dada2_taxonomy: false,      // Run DADA2 taxonomy in addition to sklearn
    classification_confidence: 0.7,
    dada2_add_species_allow_multiple: 3,
    dada2_add_species_verbose: true,
    enable_comparison: false,          // Compare sklearn vs DADA2 taxonomy
]

// === DECONTAMINATION DEFAULTS ===
params.decontam = [
    method: "frequency",
    freq_concentration_column: 'DNA_concentration',
    prev_control_column: 'Decontam_Control',
    prev_control_indicator: 'Negative Control',
    threshold: 0.1,
]

// === DIVERSITY ===
params.diversity_sampling_depth = 10000

// === CUTADAPT DEFAULTS ===
params.cutadapt = [
    minimum_length: 100,
    nextseq_trim: null,  // Set to integer (e.g. 20) for NextSeq/NovaSeq two-color chemistry data
    cpus: 4,
]

// === QUALITY CONTROL ===
params.fastqc_cpus = 2

// === ENVIRONMENT ===
params.qiime2_conda_env = '/path/to/envs/qiime2-amplicon-2025.10'
params.r_conda_env = '/path/to/envs/microbiome'
params.seed = 42

// === PROCESS CONFIGURATION ===
process {
    // Default settings
    conda = params.qiime2_conda_env
    errorStrategy = 'retry'
    maxRetries = 2

    // Resource labels
    withLabel: 'process_low' {
        cpus = 2
        memory = '4 GB'
        time = '1h'
    }

    withLabel: 'process_medium' {
        cpus = 4
        memory = '8 GB'
        time = '4h'
    }

    withLabel: 'process_high' {
        cpus = 8
        memory = '32 GB'
        time = '12h'
    }

    // Specific process overrides
    withName: 'RUN_DADA2_PAIRED_END_QIIME2' {
        cpus = 8
        memory = '32 GB'
        time = '24h'
    }

    withName: 'CREATE_NB_CLASSIFIER' {
        cpus = 4
        memory = '16 GB'
        time = '8h'
    }
}

// === PROFILES ===
profiles {
    standard {
        process.executor = 'local'
    }

    slurm {
        process.executor = 'slurm'
        process.queue = 'normal'
        process.clusterOptions = '--account=your_account'
    }

    conda {
        conda.enabled = true
        conda.useMamba = true  // Faster dependency resolution
    }

    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }

    test {
        params.dada2.n_reads_learn = 10000
        params.dada2.n_threads = 2
        params.diversity_sampling_depth = 100
    }
}

// === EXECUTION SETTINGS ===
executor {
    name = 'local'
    cpus = 16
    memory = '64 GB'
}

// === REPORTS ===
report {
    enabled = true
    file = 'reports/execution_report.html'
    overwrite = true
}

timeline {
    enabled = true
    file = 'reports/timeline.html'
    overwrite = true
}

trace {
    enabled = true
    file = 'reports/trace.txt'
    overwrite = true
}

dag {
    enabled = true
    file = 'reports/dag.html'
    overwrite = true
}

// === MANIFEST ===
manifest {
    name = 'microbiome-amplicon-analysis'
    author = 'Your Name'
    description = 'Amplicon microbiome analysis pipeline'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.04'
    version = '1.0.0'
}
